# Supabase - copy this file to `.env` and paste your project's values.
# Find them in Supabase dashboard -> Project Settings -> API.
#
# NEVER commit the real `.env`. It is gitignored on purpose: the anon key ships
# inside every APK, so anyone who reads the repo can extract it and hit the
# database directly. That is only safe while the RLS policies in
# `supabase/schema.sql` are locked down - keep them restrictive.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Where Google sends the user back to after sign-in.
# Web: leave unset (uses the site origin).
# APK: must match a <data android:scheme="..."> intent-filter in
#      android/app/src/main/AndroidManifest.xml - the shipped filter uses khelofire
VITE_OAUTH_REDIRECT=khelofire://auth-callback

# Build the separate admin APK (opens straight into /admin)
# VITE_ADMIN_BUILD=true