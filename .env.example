# Supabase - copy this file to `.env` and paste your project's values.
# Find them in Supabase dashboard -> Project Settings -> API.
#
# NEVER commit the real `.env`. It is gitignored on purpose: the anon key ships
# inside every APK, so anyone who reads the repo can extract it and hit the
# database directly. That is only safe while the RLS policies in
# `supabase/schema.sql` are locked down - keep them restrictive.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Where Google sends the user back to after sign-in.
# Web: leave unset (uses the site origin).
# APK: must match a <data android:scheme="..."> intent-filter in
#      android/app/src/main/AndroidManifest.xml - the shipped filter uses khelofire
VITE_OAUTH_REDIRECT=khelofire://auth-callback

# Build the separate admin APK (opens straight into /admin)
# VITE_ADMIN_BUILD=true

# ---------- voice chat: TURN relay (REQUIRED for voice to work everywhere) ----------
# Voice is WebRTC peer-to-peer. With STUN alone (the default when these are
# unset) two players can only connect if their networks allow a direct path.
# On a symmetric NAT - very common on 4G/mobile data - no direct path exists and
# the connection simply never forms. No amount of app code fixes that; a relay is
# the only thing that can.
#
# So if voice "does not work" for some players and works for others, this is
# almost always the reason. Until these are set, voice works on home wifi and
# fails on mobile data.
#
# Any TURN provider works: Cloudflare Calls, Metered, Twilio, or coturn you host
# yourself. For coturn the URLs are typically:
#   VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
#
# Prefer short-lived credentials from a server that mints them per session. If
# you use static ones, treat them as public - they ship inside the APK and can be
# extracted - and rotate them periodically, because a leaked relay credential
# means someone else can spend your relay bandwidth.
# VITE_TURN_URLS=turn:turn.example.com:3478?transport=udp
# VITE_TURN_USERNAME=khelofire
# VITE_TURN_CREDENTIAL=replace-me