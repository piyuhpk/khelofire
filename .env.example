# Copy to .env and fill in. .env is gitignored; this file is the tracked record of
# which variables the app reads and where each one comes from.
#
# Vite only exposes VITE_-prefixed variables to the client bundle, so anything read with
# import.meta.env must be prefixed. Do not put a secret behind a VITE_ prefix: it ships
# inside the APK where anyone can read it. The Supabase client secret is the case that
# matters - it belongs on the Supabase side only and must never appear here.

VITE_SUPABASE_URL=https://btnpyscviudnwabjobmz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ben_Eosz-spxw1q4-_Z1xw_5To7HhbS

# Google sign-in, in-app on device.
#
# A client id is not a secret - it is compiled into the bundle and readable from the
# APK - so it is committed here on purpose. Without it the app hides the Google button
# on device builds instead of failing on every tap.
#
# Android sign-in also needs the client registered in the Google console against the
# package name and the signing SHA-1; otherwise Google returns an audience error and the
# app reports it as a failed sign-in. See scripts/print-sha1.mjs for the fingerprint of
# the keystore in use.
VITE_GOOGLE_CLIENT_ID=782624199213-7d6j04o4p5v8j5rsdl5irvm5292s25am.apps.googleusercontent.com
# iOS-only. Unset on Android; setting it wrongly breaks iOS builds, not this one.
# VITE_GOOGLE_IOS_CLIENT_ID=

# Voice chat. Leave unset and the mic button is not rendered at all.
#
# Voice needs a TURN relay, not just STUN: carrier NAT blocks direct paths on most
# mobile networks, so a STUN-only build opens the mic onto nobody. A relay is a server
# somewhere, which is why this is not filled in with a value that looks plausible - a
# public relay that no longer allocates was tried here, and it gathered host and srflx
# candidates but no relay candidate in a real browser, so shipping it would have shown a
# working-looking mic that never connects.
#
# Once real credentials exist, check them before building:
#   npm run turn:check   protocol level, fast
#   npm run turn:probe   real Chromium ICE, decides whether a call can connect
# VITE_TURN_URLS=turn:your-turn-host:3478
# VITE_TURN_CREDENTIAL=
# VITE_TURN_USERNAME=